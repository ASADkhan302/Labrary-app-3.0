<Window x:Class="UniversityOfLakkiMarwatLMS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="University of Lakki Marwat - Library Management System (Desktop Edition)"
        Icon="icon.ico"
        Height="900" Width="1440"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120">
    <Grid>
        <!-- Microsoft Edge Chromium WebView2 Runtime Engine -->
        <wv2:WebView2 Name="webView" />

        <!-- Startup Loading Splash Screen Overlay (fades out when webView finishes loading) -->
        <Border Name="loadingOverlay" Background="#0B1120" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="UNIVERSITY OF LAKKI MARWAT"
                           Foreground="#F59E0B"
                           FontSize="24"
                           FontWeight="Bold"
                           FontFamily="Segoe UI Semibold, Georgia"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <TextBlock Text="LIBRARY MANAGEMENT SYSTEM • WINDOWS PC WORKSTATION"
                           Foreground="#CBD5E1"
                           FontSize="12"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />
                <ProgressBar IsIndeterminate="True"
                             Width="280"
                             Height="4"
                             Foreground="#F59E0B"
                             Background="#1E293B"
                             BorderThickness="0" />
                <TextBlock Text="Initializing offline SQLite database and campus circulation desk..."
                           Foreground="#64748B"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
